{
    "name": "mithridatem/autowiring",
    "description": "Constructor autowiring container with an optional Mithridatem Router bridge.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "mithridatem/router": "^1.2",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "mithridatem/router": "Required only for the routing bridge and routing example (^1.2)."
    },
    "autoload": {
        "psr-4": {
            "Mithridatem\\Autowiring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mithridatem\\Autowiring\\Tests\\": "tests/",
            "Example\\": "examples/routing/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "example": "php examples/basic.php",
        "lint": "php scripts/lint.php",
        "check": ["@lint", "@test", "@example"]
    }
}
